# ─────────────────────────────────────────────────────────────
# SITE
# ─────────────────────────────────────────────────────────────
# Domínio final da campanha. Sem barra no fim.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────
# SUPABASE  (ainda não conectado — fase local)
# Enquanto estas variáveis estiverem vazias, o projeto roda
# 100% com os dados locais de data/municipios-ro.json e
# data/grupos.local.json. Nada quebra.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# NUNCA prefixar com NEXT_PUBLIC. Só é lida em lib/supabase/admin.ts (server-only).
SUPABASE_SERVICE_ROLE_KEY=""

# ─────────────────────────────────────────────────────────────
# PAINEL
# ─────────────────────────────────────────────────────────────
# Fase local: senha única de acesso ao /painel. Na fase Supabase
# isso vira Supabase Auth + tabela de administradores.
PAINEL_SENHA="troque-esta-senha"
PAINEL_SESSION_SECRET="gere-um-hex-de-32-bytes"

# ─────────────────────────────────────────────────────────────
# CONFORMIDADE ELEITORAL
# ─────────────────────────────────────────────────────────────
# A partir deste instante os CTAs de campanha saem do ar sozinhos.
# Silêncio eleitoral: 00h00 de 03/10 (horário de Rondônia, UTC-4).
NEXT_PUBLIC_SILENCIO_ELEITORAL_EM="2026-10-03T04:00:00.000Z"

# Dados obrigatórios do rodapé. Sem isto CONFIRMADO, não publica.
# Os dados legais (CNPJ, nome na urna, cargo, partido, coligação,
# comitê) NÃO ficam mais aqui: passaram para o painel, em
# Textos > Rodapé > Identificação eleitoral. Corrigir um dado errado
# em campanha não pode depender de deploy.

# ─────────────────────────────────────────────────────────────
# ANALYTICS
# ─────────────────────────────────────────────────────────────
# Só preencher se houver tráfego pago. Vazio = pixel não carrega
# e o banner de consentimento não aparece.
NEXT_PUBLIC_META_PIXEL_ID=""
